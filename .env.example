# Local development configuration
# Copy this file to .env and fill in your environment values. Never commit .env.

# Model configuration (tiered multi-model routing)
# Fast model for interactive routing, extraction & formatting:
ADK_FAST_MODEL=gemini-3.8-flash
# Reasoning model for deep bias/gap auditing (gap_auditor):
ADK_REASONING_MODEL=gemini-3.1-pro-preview
# Legacy single-model override (used as fallback for ADK_FAST_MODEL):
ADK_MODEL=gemini-3.8-flash

# --- Option A: Vertex AI / Gemini Enterprise Platform via ADC (default) ---
# Authenticate first with: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# --- Option B: Gemini API via Google AI Studio ---
# Comment out the Option A lines above and uncomment below:
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GEMINI_API_KEY=your-api-key-here

# --- Optional Observability & PII Redaction ---
# GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
# OTEL_SERVICE_NAME=debrief-synthesizer
# LOG_LEVEL=INFO
# ENABLE_CLOUD_DLP=false
# BQ_ANALYTICS_DATASET_ID=debrief_synthesizer_telemetry
# LOGS_BUCKET_NAME=your-logs-bucket-name
